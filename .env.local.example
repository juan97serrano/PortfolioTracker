# ============================================================
# PORTFOLIO TRACKER — Variables de entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores.
# En Vercel: añade las variables en Settings → Environment Variables
# ============================================================

# URL del archivo de cartera (obligatorio)
# Opciones admitidas:
#
# 1. Google Sheets (recomendado) — URL pública del sheet exportado como CSV:
#    PORTFOLIO_URL=https://docs.google.com/spreadsheets/d/TU_SHEET_ID/export?format=csv
#
# 2. Google Drive — URL pública de un archivo .xlsx:
#    PORTFOLIO_URL=https://drive.google.com/file/d/TU_FILE_ID/view
#
# 3. Cualquier URL directa a un archivo .xlsx o .csv:
#    PORTFOLIO_URL=https://ejemplo.com/mi-cartera.csv

PORTFOLIO_URL=
